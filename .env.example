# =============================================================================
# IntelliStock environment template
# =============================================================================
# Copy this file to `.env` and fill in your values, OR run ./install.sh
# (or install.ps1) to auto-generate the secret-bearing entries below.
#
# DO NOT commit `.env`. The Fernet INTELLISTOCK_CRED_KEY in particular
# MUST stay stable for the lifetime of the install — losing it makes
# encrypted brokerage credentials unrecoverable.
# =============================================================================

# [IMPORTANT] You must fill in all the env vars that say <FILL THIS IN> for the application
# to work on startup for the first time

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Host port to expose the frontend on (default 3000).
FRONTEND_PORT=3000

# How the JS bundle reaches the API in the browser. Leave blank for the
# default single-host deploy — nginx in the frontend container proxies
# /api -> the api service same-origin (no CORS preflight needed).
# Set to a full URL if you serve the API on a separate origin (and
# remember to set CORS_ALLOW_ORIGINS below).
VITE_API_URL=<FILL THIS IN>

# Preview mode: set to "true" for a landing-only frontend (no portal,
# GitHub CTA in place of auth). Empty = full portal.
VITE_PREVIEW_MODE=


# -----------------------------------------------------------------------------
# PostgreSQL (the datastore as of the 2026-08 port; see backend/db/)
# -----------------------------------------------------------------------------
# Mandatory: the compose postgres service refuses to render without it.
POSTGRES_PASSWORD=<FILL THIS IN>

# PG_DSN wins over every POSTGRES_* part below when it is set. Unsetting it is
# NOT a rollback to RethinkDB — no ReQL path survives the 2026-08 port, so the
# store just falls back to the POSTGRES_* parts below. Rolling back means
# redeploying a pre-port commit.
# PG_DSN=postgresql://intellistock:PASSWORD@localhost:5432/IntelliStock
# POSTGRES_HOST=localhost        # Docker Compose: postgres (service name)
# POSTGRES_PORT=5432
# POSTGRES_USER=intellistock
# POSTGRES_DB=IntelliStock

# Publish address for the postgres container. Unlike RethinkDB this defaults to
# loopback; set it to 0.0.0.0 only on a host reachable solely over a private
# network (e.g. Tailscale).
# POSTGRES_BIND_ADDR=127.0.0.1

# --- Connection pool (backend/db/pool.py) ---
# One pool per PROCESS, created lazily after fork. max_size is what a single
# broker/engine/API worker may hold, not a cluster-wide budget.
# PG_POOL_MIN=1
# PG_POOL_MAX=8
# Seconds to wait for a free connection, and to keep retrying a dead pool.
# Production wants to ride out a blip; the test suite overrides both to 2s so a
# degradation path cannot stall a run.
# PG_POOL_TIMEOUT=30
# PG_RECONNECT_TIMEOUT=30
# Connect attempts before giving up (the retry ladder in pool.py).
# PG_CONNECT_RETRIES=4

# --- Store behaviour (backend/db/store.py, backend/db/watch.py) ---
# Guard rail: an unbounded read returning more than this raises rather than
# materialising the table. Use store.iter() for the genuinely unbounded paths.
# PG_MAX_ROWS=100000
# Poll interval for the change watchers. They are LISTEN/NOTIFY driven; this is
# the backstop that also re-reads after a reconnect, so seconds is right.
# DB_WATCH_POLL_SECONDS=2.0
# Overrides the schema every pooled connection resolves against. The test
# harness sets this per test; leave it UNSET everywhere else.
# PG_SEARCH_PATH=

# --- Spawned instance/backtest containers (server.py) ---
# Postgres as seen from INSIDE a spawned container. Either override wins over
# the value the parent process inherits; a bare host override drops the
# inherited DSN, because dsn_from_env() checks PG_DSN first.
# INSTANCE_POSTGRES_HOST=postgres
# INSTANCE_PG_DSN=

# --- Tests only ---
# Points the suite at a real Postgres. Unset, the tests run against the
# in-memory FakeStore instead of skipping. scripts/dev_pg.sh prints one.
# PG_TEST_DSN=postgresql://postgres@127.0.0.1:54329/port_a


# -----------------------------------------------------------------------------
# RethinkDB (retained for rollback until the store is decommissioned)
# -----------------------------------------------------------------------------
# Local: localhost  |  Docker Compose: rethinkdb (service name)
RETHINKDB_HOST=localhost
RETHINKDB_PORT=28015
RETHINKDB_WEB_PORT=8080


# -----------------------------------------------------------------------------
# IntelliStock Server (Socket.IO; used by priceService and priceBroker)
# -----------------------------------------------------------------------------
# Local: http://localhost:5000  |  Docker: http://intellistock-backend:5000
SERVER_URL=http://localhost:5000


# -----------------------------------------------------------------------------
# Instance Docker (server.py spawns instance/backtest containers)
# -----------------------------------------------------------------------------
# Image to run for each instance — must contain backend code + instance.py.
# When using docker-compose, set to the backend image name.
DOCKER_INSTANCE_IMAGE=intellistock-backend

# RethinkDB host as seen from inside the instance/backtest container.
# - Server in Docker: rethinkdb
# - RethinkDB on host, backtest in Docker: host.docker.internal
INSTANCE_RETHINKDB_HOST=rethinkdb

# Server URL as seen from inside the instance container (Socket.IO).
INSTANCE_SERVER_URL=http://intellistock-backend:5000


# -----------------------------------------------------------------------------
# API auth (server.py default admin, api/main.py JWT + signup gate)
# -----------------------------------------------------------------------------
# Default admin auto-provisioned on first backend boot. Backend refuses
# to start if DEFAULT_ADMIN_PASSWORD is missing or shorter than 12 chars.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=<FILL THIS IN>
# Must be > 12 chars [IMPORTANT]

# Signup gate token. /auth/signup rejects any request that doesn't carry
# this exact value. Keep it private — anyone with it can register users.
SECRET_AUTH_KEY=<FILL THIS IN>

# JWT signing secret. Backend refuses to mint tokens if unset or weak.
# Rotating it logs out every active session.
JWT_SECRET=<FILL THIS IN>

# Optional: JWT access-token lifetime in hours (default 24).
# JWT_EXPIRE_HOURS=24

# Fernet key for at-rest brokerage credential encryption. 32 random bytes,
# urlsafe-b64. KEEP STABLE for the lifetime of the install.
# Generate manually with: openssl rand 32 | base64 | tr '+/' '-_'
INTELLISTOCK_CRED_KEY=<FILL THIS IN>

# Mandatory control-plane HMAC master key. It must be exactly 64 lowercase
# hexadecimal characters and MUST remain stable across backend restarts.
# Generate a new value with: openssl rand -hex 32
SOCKET_CONTROL_MASTER_KEY=<FILL THIS IN>

# Belt-and-suspenders: refuse to read brokerage creds from env vars
# (forces the encrypted-DB path). Leave at 0 unless you need legacy mode.
ALLOW_LEGACY_ENV_CREDS=0


# -----------------------------------------------------------------------------
# Live equities session controls
# -----------------------------------------------------------------------------
# When true, restrict stock submission to RTH (9:30-16:00 ET). Defaults to
# extended-hours (4 AM - 8 PM ET) allowed by the market calendar.
# LIVE_RTH_ONLY=false

# Migration detector auto-reset. When true, the in-broker drift detector
# automatically clears stale snapshot keys (drawdown peak, cooldowns,
# V32 caches, deployment ramp) on first boot after an account-mismatch is
# detected (e.g. cached peak >>> current equity with zero positions).
# Defaults to true when Instances.<id>.clean_room_mode=true, false otherwise.
# Explicit false here overrides clean_room_mode's auto-default.
# LIVE_AUTO_RESET_ON_MIGRATION=true

# Capture the exact Graph Nexus graph queries, fundamentals, universe, and
# timestamped news consumed by successful FULL live/paper cycles. Disabled by
# default; enabling capture records evidence but does not start an instance.
PIT_CAPTURE_ENABLED=0


# -----------------------------------------------------------------------------
# CORS / API surface
# -----------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from the browser. Empty
# = no cross-origin requests at all (correct for the default single-host
# deploy where nginx proxies /api on the same origin). Set this when you
# serve the frontend on a different host/subdomain than the API, or your
# bundle was built with VITE_API_URL pointing at a separate origin —
# otherwise the browser will get OPTIONS … 405 on every preflight.
#   CORS_ALLOW_ORIGINS=https://app.example.com
#   CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
#   CORS_ALLOW_ORIGINS=http://localhost:3011,http://127.0.0.1:3011 <-- Use this for local hosting
CORS_ALLOW_ORIGINS=<FILL THIS IN>

# /docs and /openapi.json are off by default because the schema is an
# attack-surface map. Set to "true" to expose them in development.
API_DOCS_PUBLIC=


# -----------------------------------------------------------------------------
# API server (uvicorn)
# -----------------------------------------------------------------------------
API_PORT=8011
# API_HOST=0.0.0.0

# Full URL the frontend / scripts call. Inside docker-compose, the
# service name resolves automatically.
API_URL=http://intellistock-api:8011


# -----------------------------------------------------------------------------
# Alpaca (priceBroker.py — live market-data stream)
# -----------------------------------------------------------------------------
# Get keys from https://alpaca.markets/. KEY/SECRET are fallbacks; the
# Brokerages tab in the UI is the preferred place to store these
# (encrypted at rest with INTELLISTOCK_CRED_KEY).
KEY=
SECRET=
ALPACA_PAPER=true
# iex (free tier) or sip (paid). Use sip if iex returns "insufficient subscription".
ALPACA_DATA_FEED=iex
# When true, uses the v2/test stream + FAKEPACA symbol — handy out-of-hours.
ALPACA_USE_TEST_STREAM=false

# Deterministic backtest RNG seed.
BACKTEST_SEED=42
# Deterministic set iteration during stock discovery. Must be set before the
# interpreter starts; the backtest engine forwards it into spawned brokers and
# defaults it to 0 if unset. Leave at 0 for reproducible backtests.
PYTHONHASHSEED=0


# -----------------------------------------------------------------------------
# AI Backtesting Agent (agent_backtest_runner.py)
# -----------------------------------------------------------------------------
# Started/stopped via POST /agent/control or CLI: agent start / agent stop.
# Defaults to default admin credentials if unset.
AGENT_API_USERNAME=admin
AGENT_API_PASSWORD=<FILL THIS IN>
# Must be > 12 chars for the password [IMPORTANT]

# Provider keys (legacy fallbacks — prefer the Models tab in the UI which
# stores keys in the database).
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Ollama provider — optional env-var fallbacks when a Models row leaves
# these blank. Models table entries always win.
#
# OLLAMA_BASE_URL:
#   Local default:  http://localhost:11434
#   Remote host:    http://REDACTED-IP:11434
#   Ollama Cloud:   https://ollama.com/v1
# OLLAMA_API_KEY: required only for Ollama Cloud (Bearer token); leave
# blank for local or self-hosted hosts.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Stage: strategy generation
AI_BACKTESTING_STRATEGY_GENERATION_PROVIDER=deepseek
AI_BACKTESTING_STRATEGY_GENERATION_MODEL=deepseek-reasoner
AI_BACKTESTING_STRATEGY_GENERATION_API_KEY=

# Stage: validation (KEEP/TOSS after each backtest)
AI_BACKTESTING_VALIDATION_PROVIDER=deepseek
AI_BACKTESTING_VALIDATION_MODEL=deepseek-reasoner
AI_BACKTESTING_VALIDATION_API_KEY=

# Stage: best selection (decides whether to promote a strategy to "best")
AI_BACKTESTING_BEST_SELECTION_PROVIDER=gemini
AI_BACKTESTING_BEST_SELECTION_MODEL=gemini-2.5-flash
AI_BACKTESTING_BEST_SELECTION_API_KEY=

# Run-loop tuning.
AI_BACKTESTING_DAILY_GOAL=100
AI_BACKTESTING_BATCH_SIZE=5
AI_BACKTESTING_STOCK_POOL=AAPL,MSFT,GOOGL,AMZN,META,SPY,TSM

# News sub-strategy: injected as llm_api_key when agent configures News.
NEWS_API_MODEL_KEY=


# -----------------------------------------------------------------------------
# Discord bot (optional; same command surface as the CLI, prefix !)
# -----------------------------------------------------------------------------
# Bot token from Discord Developer Portal -> Applications -> Bot -> Token.
# Required only if you run the discord-bot service.
DISCORD_BOT_TOKEN=
DISCORD_BOT_LOG_LEVEL=INFO
DISCORD_BOT_HTTP_PORT=8050
# Optional: API key for POST /send (header X-API-Key). Empty disables auth
# — fine for a host-bound bot, set this if the port is reachable.
DISCORD_BOT_API_KEY=


# -----------------------------------------------------------------------------
# Daily Digest Engine (daily_digest_engine.py)
# -----------------------------------------------------------------------------
# Optional LLM that writes the morning brief. Empty = stats-only embed.
AI_DIGEST_PROVIDER=
AI_DIGEST_MODEL=
AI_DIGEST_API_KEY=


# -----------------------------------------------------------------------------
# Neo4j (Graph Nexus)
# -----------------------------------------------------------------------------
# Local: bolt://localhost:7687  |  Docker: bolt://neo4j:7687
# NEO4J_PASSWORD MUST be set — docker-compose refuses to render without it.
# Neo4j only honours NEO4J_AUTH on first boot.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<FILL THIS IN>
# Optional heap tuning. Default is 4 GB; lower for the minimum hardware
# tier (see README -> Hardware).
# NEO4J_HEAP_MAX_SIZE=4G


# -----------------------------------------------------------------------------
# Graph Nexus Service (graph_nexus_service.py)
# -----------------------------------------------------------------------------
# Polygon.io — required for Phase 1 (company universe). Free tier OK.
POLYGON_API_KEY=
POLYGON_CALLS_PER_MINUTE=5

# Scope: us | global | comma-separated sectors
GRAPH_NEXUS_SCOPE=us

# Cache + supply-chain source.
# GRAPH_NEXUS_CACHE_DIR=
GRAPH_NEXUS_SUPPLY_CHAIN_SOURCE=sec_edgar
# GRAPH_NEXUS_SUPPLY_CHAIN_CSV=
# GRAPH_NEXUS_SUPPLY_CHAIN_URL=
# GRAPH_NEXUS_SUPPLY_CHAIN_CACHE_MAX_AGE=86400
# GRAPH_NEXUS_COMMODITIES_CSV=

# Live update window.
GRAPH_NEXUS_UPDATE_TIME=03:00
GRAPH_NEXUS_LIVE_UPDATE_HOURS=24
GRAPH_NEXUS_LIVE_UPDATE=true

# Optional LLM for nexus phases (provider: gemini | deepseek).
GRAPH_NEXUS_LLM_PROVIDER=gemini
GRAPH_NEXUS_LLM_MODEL=gemini-2.5-flash
GRAPH_NEXUS_LLM_API_KEY=

# SEC EDGAR (when GRAPH_NEXUS_SUPPLY_CHAIN_SOURCE=sec_edgar). EDGAR
# requires a contact email per their fair-access policy.
SEC_EDGAR_COMPANY_NAME=YourCompanyName
SEC_EDGAR_EMAIL=you@example.com
SEC_EDGAR_RATE_LIMIT_DELAY=0.2
SEC_EDGAR_DOWNLOAD_TIMEOUT_SEC=20
SEC_EDGAR_SUPPLY_CHAIN_MAX_COMPANIES=8000
# SEC_EDGAR_SUPPLY_CHAIN_OUTPUT_CSV=

# Other Graph Nexus phases (most optional — engine degrades gracefully).
BEA_API_KEY=
# GLEIF_MAX_COMPANIES=
# USASPENDING_MAX_ROWS=
# WIKIDATA_MAX_ROWS=
# PATENTSVIEW_MAX_ROWS=
# BOARD_INTERLOCK_MAX_COMPANIES=

# Open Sanctions Hub. Either OSH_API_KEY *or* OSH_EMAIL+OSH_PASSWORD.
OSH_API_KEY=
OSH_EMAIL=
OSH_PASSWORD=

# PatentsView (USPTO). Free key from https://patentsview.org/api-keys.
PATENTSVIEW_API_KEY=
PATENTSVIEW_LLM_PROVIDER=gemini
PATENTSVIEW_LLM_MODEL=gemini-2.5-flash
PATENTSVIEW_LLM_API_KEY=
PATENTSVIEW_ZERO_PAGE_EXIT=15
PATENTSVIEW_LLM_TIMEOUT_SEC=300
PATENTSVIEW_LLM_LOG_SAMPLE_NAMES=true
PATENTSVIEW_LLM_HEARTBEAT_SEC=30


# -----------------------------------------------------------------------------
# Graph Nexus Analysis strategy (run_once: news -> Neo4j -> ticker scores)
# -----------------------------------------------------------------------------
# Benzinga news (optional; the strategy degrades to free fallbacks).
BENZINGA_API_KEY=

# These override the GRAPH_NEXUS_LLM_* fallbacks above for the headline
# sentiment stage specifically. Most users can leave them unset.
# GRAPH_NEXUS_LLM_PROVIDER=deepseek
# GRAPH_NEXUS_LLM_MODEL=deepseek-reasoner
# GRAPH_NEXUS_LLM_API_KEY=


# -----------------------------------------------------------------------------
# AI Trading Decision strategy (post-decision overlay)
# -----------------------------------------------------------------------------
AI_TRADING_DECISION_PROVIDER=deepseek
AI_TRADING_DECISION_MODEL=deepseek-reasoner
AI_TRADING_DECISION_API_KEY=


# -----------------------------------------------------------------------------
# LLM provider credentials — preferred path
# -----------------------------------------------------------------------------
# OpenAI / Azure / Gemini / DeepSeek / NVIDIA NIM keys for the chatbot
# and LLM-using strategies are managed through the Models tab in the
# web UI after onboarding. The Models table is the single source of
# truth. The legacy *_API_KEY env vars above are fallbacks only.
