            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-mcp": {
          "class": "irreversible",
          "tool": "delete_strategy",
          "target": {
            "strategy": "strategy_id"
          }
        }
      }
    },
    "/strategies/tree": {
      "post": {
        "tags": [
          "strategies"
        ],
        "description": "Preview a strategy rule tree.\nValidates the nested tree and returns the flattened rule list without saving anything.",
