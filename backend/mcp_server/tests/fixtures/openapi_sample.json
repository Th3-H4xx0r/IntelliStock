    "/internal/debug/state": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "Dump process state",
        "operationId": "debug_state",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
