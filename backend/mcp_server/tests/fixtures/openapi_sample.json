{
  "openapi": "3.1.0",
  "info": {
    "title": "IntelliStock API",
    "description": "The MCP-visible operations of the IntelliStock API.",
    "version": "1.0.0"
  },
  "paths": {
    "/instances/{instance_id}": {
      "get": {
        "tags": [
          "instances"
        ],
        "summary": "Get one instance — config, status and linked accounts",
        "operationId": "get_instance",
        "parameters": [
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Instance Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-mcp": {
          "class": "read",
          "tool": "get_instance"
        }
      },
      "head": {
        "tags": [
          "instances"
        ],
        "summary": "Check that an instance exists",
        "operationId": "head_instance",
        "parameters": [
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Instance Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-mcp": {
          "class": "read"
        }
      }
    },
    "/backtests": {
      "get": {
        "tags": [
          "backtests"
        ],
        "summary": "List backtests",
        "description": "Newest first. Page with limit and offset.",
        "operationId": "list_backtests",
        "parameters": [
          {
            "name": "instance_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Instance Id"
            },
            "description": "Only this instance's backtests."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "pending",
                    "running",
                    "finished",
                    "failed"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-mcp": {
          "class": "read",
          "tool": "list_backtests"
        }
      },
      "post": {
        "tags": [
          "backtests"
        ],
        "summary": "Start a backtest",
        "description": "Queues a backtest for an instance. It runs for minutes to hours and spends LLM budget.",
        "operationId": "create_backtest",
        "parameters": [
          {
            "name": "x-trace-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Trace-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BacktestCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-mcp": {
          "class": "write",
          "tool": "create_backtest",
          "cost": true
        }
      }
    },
    "/backtests/{backtest_id}/logs": {
      "get": {
        "tags": [
          "backtests"
        ],
        "summary": "Backtest log lines",
        "description": "The engine log of one backtest. A whole run reaches tens of megabytes; page with since_line and lines.",
        "operationId": "get_backtest_logs",
        "parameters": [
          {
            "name": "backtest_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Backtest Id"
            }
          },
          {
            "name": "since_line",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since Line"
            }
          },
          {
            "name": "lines",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20000,
              "minimum": 1,
              "default": 2000,
              "title": "Lines"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacktestLogs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-mcp": {
          "class": "read",
          "tool": "get_backtest_logs"
        }
      }
    },
    "/instances/{instance_id}/live-command": {
      "post": {
        "tags": [
          "live"
        ],
        "summary": "Send a live command to the broker",
        "description": "halt, close_position or submit_order. The broker picks it up within about a second.\n\nPoll the returned command_id for the result.",
        "operationId": "live_command",
        "parameters": [
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Instance Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiveCommandBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-mcp": {
          "class": "money",
          "tool": "live_command",
          "target": {
            "instance": "instance_id"
          }
        }
      }
    },
    "/strategies/{strategy_id}": {
      "delete": {
        "tags": [
          "strategies"
        ],
        "summary": "Delete a strategy",
        "operationId": "delete_strategy",
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Strategy Id"
            }
