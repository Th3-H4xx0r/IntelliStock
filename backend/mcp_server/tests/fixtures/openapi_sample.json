              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-mcp": {
          "class": "read",
          "tool": "get_approval"
        }
      }
    },
    "/mcp/approvals/{id}/decision": {
      "post": {
        "tags": [
          "mcp"
        ],
        "summary": "Approve or deny an approval",
        "operationId": "decide_mcp_approval",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
