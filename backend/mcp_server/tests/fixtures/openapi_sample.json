  "components": {
    "schemas": {
      "ApprovalDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "deny"
            ],
            "title": "Decision"
          },
          "body_sha256": {
            "type": "string",
            "title": "Body Sha256"
          },
          "ts": {
            "type": "integer",
            "title": "Ts"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "signature": {
            "type": "string",
            "title": "Signature"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "body_sha256",
          "ts",
          "device_id",
          "signature"
        ],
        "title": "ApprovalDecision"
      },
      "BacktestCreate": {
        "properties": {
          "instance_id": {
            "type": "string",
            "title": "Instance Id"
          },
          "window": {
            "$ref": "#/components/schemas/BacktestWindow"
          },
          "granularity": {
            "$ref": "#/components/schemas/Granularity",
            "default": "900"
          },
          "initial_capital": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 100000,
            "title": "Initial Capital"
          }
        },
        "type": "object",
        "required": [
          "instance_id",
          "window"
        ],
        "title": "BacktestCreate"
      },
      "BacktestLogs": {
        "properties": {
          "backtest_id": {
            "type": "integer",
            "title": "Backtest Id"
          },
          "total_lines": {
            "type": "integer",
            "title": "Total Lines"
          },
          "logs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Logs"
          }
        },
        "type": "object",
        "required": [
          "backtest_id",
          "total_lines",
          "logs"
        ],
        "title": "BacktestLogs"
      },
      "BacktestWindow": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "BacktestWindow"
      },
      "Granularity": {
        "type": "string",
        "enum": [
          "60",
          "300",
          "900",
          "3600"
        ],
        "title": "Granularity",
        "description": "Bar size in seconds."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LearningControl": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "pause",
              "resume",
              "reset"
            ],
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "LearningControl"
      },
      "LiveCommandBody": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "halt",
              "close_position",
              "submit_order"
            ],
            "title": "Type"
          },
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "LiveCommandBody"
      },
      "StrategyNode": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "rule": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/StrategyNode"
            },
            "type": "array",
            "default": [],
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "StrategyNode"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
